DATABASE_PASSWORD=
JWT_SECRET=
# Optional, comma-separated origins; include your deployed frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email provider. Required when email verification or password reset is enabled.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=true
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Strict

# Payment provider (Razorpay sandbox credentials; leave blank until configured).
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional first-run administrator bootstrap. Use a unique, strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
